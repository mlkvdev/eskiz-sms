# Copy to .env.integration and fill in real values.
# This file is loaded automatically by tests/integration/conftest.py
# when --run-integration is passed to pytest.

ESKIZ_EMAIL=you@example.com
ESKIZ_PASSWORD=your-password

# Optional — override only for staging/proxy.
# ESKIZ_BASE_URL=https://notify.eskiz.uz/api

# Optional — set to receive a single test SMS during the send test.
# Without this, tests that actually send SMS are skipped.
# ESKIZ_TEST_PHONE=998901234567

# Optional — override the SMS body sent by the live send test.
# Eskiz moderates bodies per-account; the default "Eskiz Test" is not
# pre-approved on every account. Set this to a body you've approved at
# my.eskiz.uz; otherwise the send test skips with a helpful message.
# ESKIZ_TEST_BODY="Your approved test message"
